# ═══════════════════════════════════════════════════
# Helpdesk Agent - Environment Configuration
# Copy to .env. The defaults below are demo values that match docker-compose.yml;
# change every secret before exposing anything beyond 127.0.0.1.
# ═══════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────────
LLAMA_MODEL_PATH=/models/qwen2.5-7b-instruct-q4_k_m.gguf
LLAMA_PORT=8081
LLAMA_CTX_SIZE=65536
LLAMA_THREADS=6

# ── Host ports (bound to 127.0.0.1; override if busy) ─
AGENT_PORT=8080
ADMIN_AGENT_PORT=8082
SEARXNG_HOST_PORT=8888

# ── Hermes Agent ─────────────────────────────────────
HERMES_API_KEY=change-me
ADMIN_API_KEY=change-me

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=helpdesk_pass

# ── Redis ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# ── ChromaDB ─────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=chromadb_token_change_me

# ── SearXNG ──────────────────────────────────────────
SEARX_HOST=searxng
SEARX_PORT=8080

# ── n8n ──────────────────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
JWT_SECRET=jwt_secret_change_me_please

# ── Email (IMAP) ─────────────────────────────────────
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=helpdesk@example.com
IMAP_PASSWORD=change-me
POLL_INTERVAL=60
TICKET_PLATFORM=osticket

# ── osTicket API ─────────────────────────────────────
OSTICKET_URL=https://support.example.com/api/tickets.json
OSTICKET_API_KEY=change-me

# ── Freshdesk API (free plan) ────────────────────────
FRESHDESK_URL=https://yourcompany.freshdesk.com
FRESHDESK_API_KEY=change-me

# ── Security / Rate Limiting ─────────────────────────
RATE_LIMIT_PER_SESSION=50
RATE_LIMIT_WINDOW=3600
MAX_MESSAGE_LENGTH=4000
MAX_SESSION_DURATION=7200

# ── Agent Mode ───────────────────────────────────────
HELPDESK_MODE=self-service
